# =============================================================================
# DENHOUSE GROUP — ENVIRONMENT VARIABLES
# Copy this file to `.env` (local dev) and configure the same keys in the
# Vercel project settings for staging/production. Never commit a real `.env`.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE (Supabase Postgres via Prisma)
# `DATABASE_URL` -> pooled connection (used by the app at runtime, port 6543)
# `DIRECT_URL`   -> direct connection (used by Prisma Migrate, port 5432)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# AUTH.JS (NextAuth v5)
# Generate AUTH_SECRET with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SUPABASE (Storage for property/PG images)
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY. Never prefix it with
# NEXT_PUBLIC_ and never reference it from a Client Component.
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public bucket base is safe to expose to the browser for building image URLs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# CONTACT EMAIL (Resend)
# RESEND_API_KEY is server-only. RESEND_FROM_EMAIL must be a verified sender
# or domain in Resend. CONTACT_TO_EMAIL is the inbox that receives enquiries.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONTACT_TO_EMAIL=""

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# BUSINESS CONTACT DETAILS (optional — nothing is shown until you set these)
# When empty, "Call Us" / "WhatsApp" buttons are hidden automatically.
# WhatsApp number: digits with country code, e.g. 919999999999
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE="+91 80767 99469"
NEXT_PUBLIC_WHATSAPP_NUMBER="918076799469"
NEXT_PUBLIC_CONTACT_EMAIL="denhousegroup@gmail.com"

# Local development seed only (prisma/seed.ts). Never reuse in production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
